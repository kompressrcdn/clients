{
  "type": "stdio",
  "runtime": "node",
  "serverCard": {
    "serverInfo": {
      "name": "kompressr",
      "version": "2.0.0"
    },
    "tools": [
      {
        "name": "register",
        "description": "Create an account and send a verification email. API uploads require a paid plan. Cannot replace an already configured runtime.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "email": {
              "type": "string",
              "format": "email",
              "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
            },
            "password": {
              "type": "string",
              "minLength": 8
            }
          },
          "required": [
            "email",
            "password"
          ],
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": false,
          "openWorldHint": true
        },
        "execution": {
          "taskSupport": "forbidden"
        }
      },
      {
        "name": "verify_email",
        "description": "Verify an email token and save credentials locally. Refuses to replace an already configured runtime.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "token": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "token"
          ],
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": false,
          "openWorldHint": true
        },
        "execution": {
          "taskSupport": "forbidden"
        }
      },
      {
        "name": "upload_asset",
        "description": "Upload a supported image, video, PDF, font or text asset. Acceptance is not readiness: wait for processed before sharing. Project-user scoped upload keys restrict uploads to their identity. API uploads require a paid plan.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "file_path": {
              "description": "Local file path; provide exactly one file source",
              "type": "string"
            },
            "file_url": {
              "description": "HTTP(S) file downloaded on the MCP machine, then uploaded",
              "type": "string",
              "format": "uri"
            },
            "quality": {
              "description": "Video quality only; availability depends on the plan",
              "type": "string",
              "enum": [
                "480p",
                "720p",
                "1080p",
                "4k"
              ]
            },
            "visibility": {
              "type": "string",
              "enum": [
                "public",
                "private"
              ]
            },
            "private_url_expires_in": {
              "type": "integer",
              "minimum": 60,
              "maximum": 604800
            },
            "data": {
              "description": "At most five scalar fields; UTF-8/encoded size limits apply",
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 512
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          },
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": false,
          "openWorldHint": true
        },
        "execution": {
          "taskSupport": "forbidden"
        }
      },
      {
        "name": "get_asset_status",
        "description": "Inspect processing status and delivery information. Scoped keys only read uploads owned by their identity. A URL is ready only for active processed assets.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "asset_id": {
              "anyOf": [
                {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                {
                  "type": "string",
                  "pattern": "^[1-9]\\d*$"
                }
              ]
            }
          },
          "required": [
            "asset_id"
          ],
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "annotations": {
          "readOnlyHint": true,
          "destructiveHint": false,
          "idempotentHint": true,
          "openWorldHint": true
        },
        "execution": {
          "taskSupport": "forbidden"
        }
      },
      {
        "name": "list_assets",
        "description": "List uploaded files in the configured project, with pagination and processing/deletion filters. A scoped key lists only its identity uploads. KOMPRESSR_PROJECT_ID is required.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "page": {
              "default": 1,
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "limit": {
              "default": 20,
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "visibility": {
              "type": "string",
              "enum": [
                "public",
                "private"
              ]
            },
            "external_id": {
              "type": "string",
              "maxLength": 512
            },
            "status": {
              "type": "string",
              "enum": [
                "pending",
                "processing",
                "processed",
                "failed",
                "unprocessable"
              ]
            },
            "deletion_status": {
              "type": "string",
              "enum": [
                "active",
                "deleting",
                "deleted",
                "legacy_deleted"
              ]
            },
            "data": {
              "type": "object",
              "propertyNames": {
                "type": "string",
                "maxLength": 64
              },
              "additionalProperties": {
                "type": "string",
                "maxLength": 512
              }
            }
          },
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "annotations": {
          "readOnlyHint": true,
          "destructiveHint": false,
          "idempotentHint": true,
          "openWorldHint": true
        },
        "execution": {
          "taskSupport": "forbidden"
        }
      },
      {
        "name": "generate_private_url",
        "description": "Generate a fresh expiring URL after private upload processing and application access checks. Scoped keys only sign their own identity private uploads. Expiry does not delete the asset.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "asset_id": {
              "anyOf": [
                {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                {
                  "type": "string",
                  "pattern": "^[1-9]\\d*$"
                }
              ]
            },
            "expires_in": {
              "default": 3600,
              "type": "integer",
              "minimum": 60,
              "maximum": 604800
            },
            "variant": {
              "default": "webp",
              "type": "string",
              "enum": [
                "webp",
                "avif"
              ]
            }
          },
          "required": [
            "asset_id"
          ],
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "annotations": {
          "readOnlyHint": true,
          "destructiveHint": false,
          "idempotentHint": true,
          "openWorldHint": true
        },
        "execution": {
          "taskSupport": "forbidden"
        }
      },
      {
        "name": "wait_for_asset",
        "description": "Wait within a bounded time budget for an active upload to process. A timeout preserves the asset ID; resume rather than reupload. Private uploads need generate_private_url after readiness.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "asset_id": {
              "anyOf": [
                {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                {
                  "type": "string",
                  "pattern": "^[1-9]\\d*$"
                }
              ],
              "description": "Positive numeric asset ID; not a URL or external customer ID"
            },
            "timeout_ms": {
              "default": 120000,
              "type": "integer",
              "minimum": 1,
              "maximum": 120000
            }
          },
          "required": [
            "asset_id"
          ],
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "annotations": {
          "readOnlyHint": true,
          "destructiveHint": false,
          "idempotentHint": true,
          "openWorldHint": true
        },
        "execution": {
          "taskSupport": "forbidden"
        }
      },
      {
        "name": "get_asset_deletion_status",
        "description": "Inspect processing/deletion state and storage credits for an asset ID. File removal completion does not certify that all caches have cleared.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "asset_id": {
              "anyOf": [
                {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                {
                  "type": "string",
                  "pattern": "^[1-9]\\d*$"
                }
              ],
              "description": "Positive numeric asset ID; not a URL or external customer ID"
            }
          },
          "required": [
            "asset_id"
          ],
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "annotations": {
          "readOnlyHint": true,
          "destructiveHint": false,
          "idempotentHint": true,
          "openWorldHint": true
        },
        "execution": {
          "taskSupport": "forbidden"
        }
      },
      {
        "name": "delete_asset",
        "description": "Permanently delete one explicit asset ID. Irreversible; no restore or cancellation. Scoped keys need explicit delete permission. Acceptance starts background cleanup; cached/offline copies may remain.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "asset_id": {
              "anyOf": [
                {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                {
                  "type": "string",
                  "pattern": "^[1-9]\\d*$"
                }
              ],
              "description": "Positive numeric asset ID; not a URL or external customer ID"
            }
          },
          "required": [
            "asset_id"
          ],
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": true,
          "idempotentHint": true,
          "openWorldHint": true
        },
        "execution": {
          "taskSupport": "forbidden"
        }
      },
      {
        "name": "bulk_delete_assets",
        "description": "Permanently delete 1–100 explicit asset IDs. Inspect each result: a successful HTTP request can contain failed items. Scoped keys require delete permission. No query-based deletion or undo.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "asset_ids": {
              "minItems": 1,
              "maxItems": 100,
              "type": "array",
              "items": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              }
            }
          },
          "required": [
            "asset_ids"
          ],
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": true,
          "idempotentHint": true,
          "openWorldHint": true
        },
        "execution": {
          "taskSupport": "forbidden"
        }
      }
    ],
    "resources": [],
    "prompts": []
  },
  "configSchema": {
    "type": "object",
    "properties": {
      "api_key": {
        "type": "string",
        "title": "Kompressr API key",
        "description": "Your project or scoped API key. Use a scoped key for an individual agent.",
        "writeOnly": true
      },
      "project_id": {
        "type": "string",
        "title": "Project ID",
        "description": "Project UUID. Required for listing uploads; other file operations need only the API key.",
        "default": ""
      }
    },
    "required": [
      "api_key"
    ]
  }
}
