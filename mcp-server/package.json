{
  "name": "@kompressr/mcp-server",
  "version": "2.0.1",
  "description": "Kompressr CDN MCP server for AI agents \u2014 upload, optimize, and serve assets",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "kompressr-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "npm run build && node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build",
    "install:local-sdk": "node scripts/install-local-sdk.mjs",
    "verify": "npm run build && npm run typecheck && npm test && node scripts/verify-packages.mjs"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "kompressr",
    "cdn",
    "image-optimization",
    "asset-optimization",
    "ai-agent",
    "claude",
    "cursor"
  ],
  "homepage": "https://kompressr.com/agents",
  "license": "MIT",
  "author": "Kompressr",
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@kompressr/sdk": "1.0.1",
    "@modelcontextprotocol/sdk": "1.32.1",
    "zod": "4.6.7"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "RELEASING.md"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "next"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "typescript": "5.9.3",
    "vitest": "5.0.4",
    "vite": "8.3.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kompressrcdn/clients.git",
    "directory": "mcp-server"
  },
  "bugs": {
    "url": "https://github.com/kompressrcdn/clients/issues"
  }
}
