{
  "name": "@kompressr/sdk",
  "version": "1.0.2",
  "description": "Kompressr file storage, optimization and delivery client for Node.js and TypeScript",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "API.md",
    "CHANGELOG.md",
    "LICENSE",
    "examples",
    "CONTRIBUTING.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepack": "npm run build",
    "verify": "npm run build && npm run typecheck && npm test && node scripts/verify-package.mjs"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "license": "MIT",
  "author": "Kompressr",
  "homepage": "https://kompressr.com/developers",
  "publishConfig": {
    "access": "public",
    "tag": "next"
  },
  "keywords": [
    "kompressr",
    "storage",
    "cdn",
    "uploads",
    "sdk",
    "typescript"
  ],
  "devDependencies": {
    "@types/node": "^22.19.0",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kompressrcdn/clients.git",
    "directory": "sdk-js"
  },
  "bugs": {
    "url": "https://github.com/kompressrcdn/clients/issues"
  }
}
